#include <windows.h>
1 RT_MANIFEST "Helper.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WinActivate elevated activation helper\0"
            VALUE "FileVersion", "0.2.0.0\0"
            VALUE "OriginalFilename", "WinActivateHelper.exe\0"
            VALUE "ProductName", "WinActivate Manager\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
